"""
Train XGBoost microclimate temperature models.

This script trains three separate models for understory Tmean, Tmax and Tmin.
It follows the validation workflow used in the manuscript:

1. Random cross validation
2. Within-site temporal validation
3. Leave-one-site-out spatial block validation
4. Final model fitting and export

Input
-----
A CSV file containing monthly matched microclimate observations and predictors.
The default file name is:
    Merged_Data_Daily_Radiation.csv

Main outputs
------------
- trained XGBoost models
- feature lists
- feature importance tables
- overall validation metrics
- site-level LOSO metrics
- simple diagnostic plots
- partial dependence plots

Edit the paths and options in the CONFIG section before running.
"""

from __future__ import annotations

import warnings
from pathlib import Path
from typing import Dict, List, Tuple

import joblib
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from sklearn.inspection import PartialDependenceDisplay
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.model_selection import (
    KFold,
    LeaveOneGroupOut,
    RandomizedSearchCV,
    train_test_split,
)
from xgboost import XGBRegressor

warnings.filterwarnings("ignore")


# =============================================================================
# CONFIG
# =============================================================================

INPUT_CSV = Path("Merged_Data_Daily_Radiation.csv")
OUTPUT_DIR = Path("model_outputs")

GROUP_COLUMN = "ID"
RANDOM_STATE = 42
N_RANDOM_SEARCH = 30
MAKE_PLOTS = True

PARAM_GRID = {
    "n_estimators": [200, 300, 400],
    "max_depth": [3, 4, 5, 6],
    "learning_rate": [0.01, 0.03, 0.05],
    "subsample": [0.6, 0.7, 0.8, 0.9],
    "colsample_bytree": [0.6, 0.7, 0.8, 0.9],
    "min_child_weight": [3, 5, 7],
    "gamma": [0, 0.1, 0.5],
    "reg_alpha": [0, 0.1, 0.5, 1.0],
    "reg_lambda": [0.5, 1.0, 2.0],
}

MODEL_SPECS = {
    "Tmean": {
        "target": "Tmean",
        "features": [
            "Tmean_C_air",
            "RSDS_MJ_m2_day",
            "RLDS_MJ_m2_day",
            "VPD_mean_kPa",
            "Precip_mm",
            "LAI",
            "CanopyHeight_m",
            "RSDS_LAI",
            "RLDS_LAI",
            "RSDS_Height",
            "Height_LAI",
            "VPD_LAI",
            "Elev_m",
            "Slope_deg",
            "Northness",
            "Eastness",
            "Wind_mean_ms",
        ],
    },
    "Tmax": {
        "target": "tem_max",
        "features": [
            "Tmax_mean_air",
            "RSDS_MJ_m2_day",
            "VPD_mean_kPa",
            "LAI",
            "CanopyHeight_m",
            "RSDS_LAI",
            "VPD_LAI",
            "RSDS_Height",
            "Height_LAI",
            "Elev_m",
            "Slope_deg",
            "Wind_mean_ms",
            "Precip_mm",
        ],
    },
    "Tmin": {
        "target": "tem_min",
        "features": [
            "Tmin_mean_air",
            "RLDS_MJ_m2_day",
            "CanopyHeight_m",
            "LAI",
            "VPD_mean_kPa",
            "RLDS_LAI",
            "RLDS_Height",
            "Height_LAI",
            "VPD_LAI",
            "Elev_m",
            "Wind_mean_ms",
            "Precip_mm",
            "Slope_deg",
        ],
    },
}


# =============================================================================
# DATA PREPARATION
# =============================================================================

def load_data(path: Path) -> pd.DataFrame:
    """Load the input table and remove duplicated columns."""
    if not path.exists():
        raise FileNotFoundError(f"Input file not found: {path}")

    df = pd.read_csv(path)
    df = df.loc[:, ~df.columns.duplicated()].copy()

    if GROUP_COLUMN not in df.columns:
        raise ValueError(f"Missing required group column: {GROUP_COLUMN}")

    if "Tmean" not in df.columns:
        if {"tem_max", "tem_min"}.issubset(df.columns):
            df["Tmean"] = (df["tem_max"] + df["tem_min"]) / 2
        else:
            raise ValueError("Tmean is missing and tem_max/tem_min are unavailable.")

    return df


def add_interaction_features(df: pd.DataFrame) -> pd.DataFrame:
    """Create interaction features used by the final models."""
    df = df.copy()

    df["VPD_LAI"] = df["VPD_mean_kPa"] * df["LAI"]
    df["VPD_Height"] = df["VPD_mean_kPa"] * df["CanopyHeight_m"]
    df["RSDS_LAI"] = df["RSDS_MJ_m2_day"] * df["LAI"]
    df["RLDS_LAI"] = df["RLDS_MJ_m2_day"] * df["LAI"]
    df["RSDS_Height"] = df["RSDS_MJ_m2_day"] * df["CanopyHeight_m"]
    df["RLDS_Height"] = df["RLDS_MJ_m2_day"] * df["CanopyHeight_m"]
    df["Height_LAI"] = df["CanopyHeight_m"] * df["LAI"]
    df["LAI_squared"] = df["LAI"] ** 2
    df["RSDS_RLDS_ratio"] = df["RSDS_MJ_m2_day"] / (df["RLDS_MJ_m2_day"] + 1e-3)

    return df


def check_features(df: pd.DataFrame, features: List[str], target: str) -> List[str]:
    """Keep only available features and raise an error if the target is missing."""
    if target not in df.columns:
        raise ValueError(f"Missing target column: {target}")

    missing = [name for name in features if name not in df.columns]
    if missing:
        print(f"Warning: missing features for {target}: {missing}")

    available = [name for name in features if name in df.columns]
    if not available:
        raise ValueError(f"No valid predictors available for target: {target}")

    return available


# =============================================================================
# VALIDATION FUNCTIONS
# =============================================================================

def metrics(y_true: np.ndarray, y_pred: np.ndarray) -> Dict[str, float]:
    """Return R2, RMSE and MAE."""
    return {
        "R2": r2_score(y_true, y_pred),
        "RMSE": float(np.sqrt(mean_squared_error(y_true, y_pred))),
        "MAE": mean_absolute_error(y_true, y_pred),
    }


def random_cv(
    df: pd.DataFrame,
    target: str,
    features: List[str],
    params: Dict,
    n_splits: int = 5,
) -> Dict[str, float]:
    """Random K-fold validation using pooled predictions."""
    y_true_all, y_pred_all = [], []
    kfold = KFold(n_splits=n_splits, shuffle=True, random_state=RANDOM_STATE)

    for train_idx, test_idx in kfold.split(df):
        train, test = df.iloc[train_idx], df.iloc[test_idx]
        model = XGBRegressor(**params)
        model.fit(train[features], train[target], verbose=False)

        y_true_all.extend(test[target].to_numpy())
        y_pred_all.extend(model.predict(test[features]))

    return metrics(np.asarray(y_true_all), np.asarray(y_pred_all))


def within_site_cv(
    df: pd.DataFrame,
    target: str,
    features: List[str],
    params: Dict,
    test_size: float = 0.3,
) -> Dict[str, float]:
    """Within-site validation using a 70/30 split within each site."""
    y_true_all, y_pred_all = [], []

    for site_id, site_df in df.groupby(GROUP_COLUMN):
        if len(site_df) < 20:
            continue

        train, test = train_test_split(
            site_df,
            test_size=test_size,
            random_state=RANDOM_STATE,
        )

        model = XGBRegressor(**params)
        model.fit(train[features], train[target], verbose=False)

        y_true_all.extend(test[target].to_numpy())
        y_pred_all.extend(model.predict(test[features]))

    return metrics(np.asarray(y_true_all), np.asarray(y_pred_all))


def loso_cv(
    df: pd.DataFrame,
    target: str,
    features: List[str],
    params: Dict,
) -> Tuple[Dict[str, float], pd.DataFrame, pd.DataFrame]:
    """
    Leave-one-site-out spatial block validation.

    Overall metrics are calculated by concatenating predictions from all withheld
    sites and then computing one R2, RMSE and MAE value.
    """
    y_true_all, y_pred_all, site_all = [], [], []
    site_metrics = []

    for test_site in df[GROUP_COLUMN].unique():
        train = df[df[GROUP_COLUMN] != test_site]
        test = df[df[GROUP_COLUMN] == test_site]

        model = XGBRegressor(**params)
        model.fit(train[features], train[target], verbose=False)
        pred = model.predict(test[features])

        y_true = test[target].to_numpy()
        y_true_all.extend(y_true)
        y_pred_all.extend(pred)
        site_all.extend([test_site] * len(test))

        site_result = metrics(y_true, pred)
        site_result.update({
            "Site_ID": test_site,
            "Sample_Size": len(test),
        })
        site_metrics.append(site_result)

    predictions = pd.DataFrame({
        "Site_ID": site_all,
        "Observed": y_true_all,
        "Predicted": y_pred_all,
    })

    overall = metrics(predictions["Observed"].to_numpy(), predictions["Predicted"].to_numpy())
    site_table = pd.DataFrame(site_metrics)

    return overall, site_table, predictions


# =============================================================================
# MODEL TRAINING
# =============================================================================

def tune_hyperparameters(
    df: pd.DataFrame,
    target: str,
    features: List[str],
) -> Dict:
    """Tune XGBoost hyperparameters using site-blocked cross validation."""
    groups = df[GROUP_COLUMN].to_numpy()

    search = RandomizedSearchCV(
        estimator=XGBRegressor(random_state=RANDOM_STATE, n_jobs=-1),
        param_distributions=PARAM_GRID,
        n_iter=N_RANDOM_SEARCH,
        cv=LeaveOneGroupOut(),
        scoring="r2",
        n_jobs=-1,
        random_state=RANDOM_STATE,
        verbose=1,
    )

    search.fit(df[features], df[target], groups=groups)

    best_params = dict(search.best_params_)
    best_params.update({
        "random_state": RANDOM_STATE,
        "n_jobs": -1,
    })

    print(f"Best internal LOSO CV score for {target}: {search.best_score_:.3f}")
    return best_params


def train_one_model(
    df: pd.DataFrame,
    model_name: str,
    target: str,
    features: List[str],
    output_dir: Path,
) -> Dict[str, float]:
    """Tune, validate, train and save one model."""
    print("\n" + "=" * 80)
    print(f"Training {model_name}")
    print("=" * 80)

    features = check_features(df, features, target)
    model_df = df[[GROUP_COLUMN, target] + features].dropna().copy()

    print(f"Samples: {len(model_df)}")
    print(f"Sites: {model_df[GROUP_COLUMN].nunique()}")
    print(f"Features: {len(features)}")

    params = tune_hyperparameters(model_df, target, features)

    random_result = random_cv(model_df, target, features, params)
    within_result = within_site_cv(model_df, target, features, params)
    loso_result, site_table, loso_predictions = loso_cv(model_df, target, features, params)

    final_model = XGBRegressor(**params)
    final_model.fit(model_df[features], model_df[target], verbose=False)

    model_dir = output_dir / model_name
    model_dir.mkdir(parents=True, exist_ok=True)

    joblib.dump(final_model, model_dir / f"{model_name}_xgboost_model.pkl")
    pd.DataFrame({"feature": features}).to_csv(model_dir / f"{model_name}_features.csv", index=False)
    pd.DataFrame([params]).to_csv(model_dir / f"{model_name}_best_params.csv", index=False)

    importance = pd.DataFrame({
        "feature": features,
        "importance": final_model.feature_importances_,
    }).sort_values("importance", ascending=False)
    importance.to_csv(model_dir / f"{model_name}_feature_importance.csv", index=False)

    site_table.to_csv(model_dir / f"{model_name}_LOSO_site_metrics.csv", index=False)
    loso_predictions.to_csv(model_dir / f"{model_name}_LOSO_predictions.csv", index=False)

    validation_table = pd.DataFrame([
        {"Model": model_name, "Validation": "Random CV", **random_result},
        {"Model": model_name, "Validation": "Within-site", **within_result},
        {"Model": model_name, "Validation": "LOSO spatial block", **loso_result},
    ])
    validation_table.to_csv(model_dir / f"{model_name}_validation_metrics.csv", index=False)

    if MAKE_PLOTS:
        plot_diagnostics(model_name, validation_table, importance, loso_predictions, model_dir)
        plot_pdp(model_name, final_model, model_df, features, importance, model_dir)

    print(validation_table[["Model", "Validation", "R2", "RMSE", "MAE"]])
    return validation_table


# =============================================================================
# PLOTTING
# =============================================================================

def plot_diagnostics(
    model_name: str,
    validation_table: pd.DataFrame,
    importance: pd.DataFrame,
    loso_predictions: pd.DataFrame,
    output_dir: Path,
) -> None:
    """Create a compact diagnostic figure for one model."""
    fig, axes = plt.subplots(1, 3, figsize=(15, 4.5))

    axes[0].bar(validation_table["Validation"], validation_table["R2"])
    axes[0].axhline(0, color="black", linewidth=0.8)
    axes[0].set_ylabel("R2")
    axes[0].set_title("Validation performance")
    axes[0].tick_params(axis="x", rotation=25)

    top = importance.head(10).iloc[::-1]
    axes[1].barh(top["feature"], top["importance"])
    axes[1].set_xlabel("Relative importance")
    axes[1].set_title("Top predictors")

    y_true = loso_predictions["Observed"].to_numpy()
    y_pred = loso_predictions["Predicted"].to_numpy()
    axes[2].scatter(y_true, y_pred, s=10, alpha=0.4)
    lim_min = min(y_true.min(), y_pred.min())
    lim_max = max(y_true.max(), y_pred.max())
    axes[2].plot([lim_min, lim_max], [lim_min, lim_max], "k--", linewidth=1)
    axes[2].set_xlabel("Observed")
    axes[2].set_ylabel("Predicted")
    axes[2].set_title("LOSO predictions")

    fig.suptitle(f"{model_name} model diagnostics")
    fig.tight_layout()
    fig.savefig(output_dir / f"{model_name}_diagnostics.png", dpi=300)
    plt.close(fig)


def plot_pdp(
    model_name: str,
    model: XGBRegressor,
    df: pd.DataFrame,
    features: List[str],
    importance: pd.DataFrame,
    output_dir: Path,
    n_features: int = 8,
) -> None:
    """Create partial dependence plots for the most important predictors."""
    selected = importance["feature"].head(n_features).tolist()

    fig, ax = plt.subplots(figsize=(14, 9))
    PartialDependenceDisplay.from_estimator(
        model,
        df[features],
        selected,
        kind="average",
        grid_resolution=50,
        ax=ax,
    )
    fig.suptitle(f"Partial dependence plots for {model_name}")
    fig.tight_layout()
    fig.savefig(output_dir / f"{model_name}_partial_dependence.png", dpi=300)
    plt.close(fig)


# =============================================================================
# MAIN
# =============================================================================

def main() -> None:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    df = load_data(INPUT_CSV)
    df = add_interaction_features(df)

    print(f"Loaded {len(df)} rows from {INPUT_CSV}")
    print(f"Number of sites: {df[GROUP_COLUMN].nunique()}")

    all_results = []

    for model_name, spec in MODEL_SPECS.items():
        result = train_one_model(
            df=df,
            model_name=model_name,
            target=spec["target"],
            features=spec["features"],
            output_dir=OUTPUT_DIR,
        )
        all_results.append(result)

    final_summary = pd.concat(all_results, ignore_index=True)
    final_summary.to_csv(OUTPUT_DIR / "all_model_validation_metrics.csv", index=False)

    print("\nFinal validation summary")
    print(final_summary[["Model", "Validation", "R2", "RMSE", "MAE"]])
    print(f"\nAll outputs saved to: {OUTPUT_DIR.resolve()}")


if __name__ == "__main__":
    main()
